# URL del Cloudflare Worker che espone POST /chat.
# Senza questa variabile il terminale resta in modalità locale e non chiama nessun modello.
VITE_ASSISTANT_ENDPOINT=https://astra-assistant.YOUR-SUBDOMAIN.workers.dev/chat

# Link pubblico Calendly/Cal.com usato dal comando "book" e dal CTA delle risposte.
# Deve combaciare con BOOKING_URL in worker/wrangler.toml.
VITE_BOOKING_URL=https://cal.com/tony-russo-kwvzt9/call-sviluppo-software-automazioni-e-ai?overlayCalendar=true
